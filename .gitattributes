# 统一行尾：仓库里存 LF，Windows 工作区检出 CRLF
* text=auto

*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# PowerShell 脚本在 Windows 上用 CRLF 更省事
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.apk   binary
*.exe   binary
